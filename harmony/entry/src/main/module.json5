{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:module_desc",
        "icon": "$media:startIcon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        // VPN extension hosting the meow-rs engine + tun2socks. Started
        // from the UI via vpnExtension.startVpnExtensionAbility(); the TUN
        // fd from VpnConnection.create() is handed to the native layer
        // (libmeow.so -> libmihomo_ohos_ffi.so).
        "name": "MeowVpnAbility",
        "srcEntry": "./ets/vpnability/MeowVpnAbility.ets",
        "description": "$string:vpn_ability_desc",
        "icon": "$media:startIcon",
        "label": "$string:EntryAbility_label",
        "type": "vpn",
        "exported": false
      }
    ]
  }
}
