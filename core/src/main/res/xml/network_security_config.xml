<?xml version="1.0" encoding="utf-8"?>
<!--
  The engine's controller API is plain HTTP on loopback (MeowInstance binds
  127.0.0.1:9090; MeowApi talks to it). Since targetSdk 28 the platform blocks
  cleartext by default and loopback is *not* exempt, and OkHttp enforces that
  policy in RealConnection.connect — so every controller call failed with
  "CLEARTEXT communication to 127.0.0.1 not permitted by network security
  policy". The old Flutter client never hit this because dart:io does its own
  socket work and never consults NetworkSecurityPolicy.

  Only loopback is exempted; there is no base-config here, so everything else
  keeps the platform default of cleartext-denied.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
